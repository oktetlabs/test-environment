/**
 * @file
 * @brief Grouping of the API reference
 *
 * These groups hold the reference together; they document no code of their
 * own. Doxygen nests a module under the @ingroup it names only when that name
 * is defined somewhere, so they are defined here. Previously they were
 * hand-written pages under doc/sphinx/pages/ that faked the Doxygen anchor,
 * which left the navigation half generated and half maintained by hand.
 */

/**
 * @defgroup te_lib_rpc_other Other calls
 * @ingroup te_lib_rpc_tapi
 * @{
 *
 * Calls that belong to no single family: platform-specific interfaces and
 * hardware a test bed happens to have.
 * @}
 */

/**
 * @defgroup te_lib_rpc_sys Processes and system calls
 * @ingroup te_lib_rpc_tapi
 * @{
 *
 * Everything around the I/O: signals, loading libraries into an RPC
 * server, and resolving names to addresses and interfaces.
 * @}
 */

/**
 * @defgroup te_lib_rpc_rte RTE calls
 * @ingroup te_lib_rpc_tapi
 * @{
 *
 * The DPDK libraries driven from a test: the environment abstraction
 * layer, the poll mode driver API, and the buffer and pool types they use.
 * @}
 */

/**
 * @defgroup te_lib_rpc_io Socket calls
 * @ingroup te_lib_rpc_tapi
 * @{
 *
 * The socket and file descriptor calls a test makes on the host under test
 * - the bulk of what a networking scenario does.
 * @}
 */

/**
 * @defgroup te_tools_data Data structures
 * @ingroup te_tools
 * @{
 *
 * The containers TE code reaches for: growable arrays and buffers, maps,
 * sets and trees, plus the allocator they are built on.
 * @}
 */

/**
 * @defgroup te_tools_logging Logging and diagnostics
 * @ingroup te_tools
 * @{
 *
 * What engine and agent code uses to get information into the log, and the
 * helpers that format it on the way.
 * @}
 */

/**
 * @defgroup te_tools_types Network and hardware types
 * @ingroup te_tools
 * @{
 *
 * Shared representations of the addresses, headers and device identifiers
 * that engine and agent both have to speak.
 * @}
 */

/**
 * @defgroup te_tools_numeric Numbers, time and randomness
 * @ingroup te_tools
 * @{
 *
 * Arithmetic that has to be checked, quantities that carry units, clocks
 * and the random sources tests draw from.
 * @}
 */

/**
 * @defgroup te_tools_process Processes and files
 * @ingroup te_tools
 * @{
 *
 * Running something else and dealing with what it leaves behind.
 * @}
 */

/**
 * @defgroup te_tools_serial Serial console
 * @ingroup te_tools
 * @{
 *
 * Reading a device's serial console and reacting to what appears on it.
 * @}
 */

/**
 * @defgroup te_tools_serial_fmt Serialisation
 * @ingroup te_tools
 * @{
 *
 * Reading and writing the structured formats TE exchanges with the outside
 * world.
 * @}
 */

/**
 * @defgroup te_tools_text Strings and text
 * @ingroup te_tools
 * @{
 *
 * Building, parsing and comparing strings without hand-rolling the buffer
 * management each time.
 * @}
 */

/**
 * @defgroup te_ts_tapi Test API
 * @ingroup te_ts
 * @{
 *
 * The Test API (TAPI) is what a test scenario is written against. Every
 * module below wraps some capability of a :ref:`Test Agent <doxid-
 * group__te__agents>` - a remote procedure call, a configuration subtree,
 * a traffic generator, a command line tool - behind a C interface that a
 * test can call directly. Tests link against these libraries; they are
 * engine-side, not agent-side. The :ref:`Test Suite <doxid-group__te__ts>`
 * page describes how a suite is laid out and built, and :ref:`Test <doxid-
 * group__te__ts__tapi__test>` covers the scaffolding every test scenario
 * uses.
 * @}
 */

/**
 * @defgroup tapi_conf Configuring the test bed
 * @ingroup te_ts_tapi
 * @{
 *
 * Test scenarios can use functions exported by Configurator API directly:
 * :ref:`API: Configurator <doxid-group__confapi__base>`, but there are
 * high level interfaces that simplify access to some parts of
 * configuration tree.
 * @}
 */

/**
 * @defgroup tapi_conf_addr Addressing and routing
 * @ingroup tapi_conf
 * @{
 *
 * Where packets are sent and which addresses a test may use.
 * @}
 */

/**
 * @defgroup tapi_conf_diag Diagnostics and console
 * @ingroup tapi_conf
 * @{
 *
 * Watching what the agent and the device under test are doing while a test
 * runs.
 * @}
 */

/**
 * @defgroup tapi_conf_host Host resources
 * @ingroup tapi_conf
 * @{
 *
 * What the machine under an agent has and what is loaded on it.
 * @}
 */

/**
 * @defgroup tapi_conf_link Interfaces and links
 * @ingroup tapi_conf
 * @{
 *
 * The interfaces themselves: addresses and flags, what the driver offers,
 * and the bridges, bonds and queues layered on top.
 * @}
 */

/**
 * @defgroup tapi_conf_serv Network services and daemons
 * @ingroup tapi_conf
 * @{
 *
 * Servers, tunnels and virtualisation a test starts on an agent to build
 * the environment it needs.
 * @}
 */

/**
 * @defgroup tapi_conf_tree The configuration tree itself
 * @ingroup tapi_conf
 * @{
 *
 * Working with Configurator rather than with what it configures: local
 * storage, caching, change tracking and the agents themselves.
 * @}
 */

/**
 * @defgroup tapi_conf_topo Topology and namespaces
 * @ingroup tapi_conf
 * @{
 *
 * How the agents in a test bed are wired to one another, and which network
 * namespace each interface lives in.
 * @}
 */

/**
 * @defgroup tapi_devices Devices and services
 * @ingroup te_ts_tapi
 * @{
 *
 * Driving a specific subsystem or protocol on the host under test.
 * @}
 */

/**
 * @defgroup tapi_media Media data
 * @ingroup tapi_devices
 * @{
 *

 * @}
 */

/**
 * @defgroup tapi_storage Storage
 * @ingroup tapi_devices
 * @{
 *

 * @}
 */

/**
 * @defgroup tapi_upnp UPnP
 * @ingroup tapi_devices
 * @{
 *

 * @}
 */

/**
 * @defgroup tapi_wifi Wi-Fi client
 * @ingroup tapi_devices
 * @{
 *

 * @}
 */

/**
 * @defgroup tapi_dpdk_grp DPDK
 * @ingroup te_ts_tapi
 * @{
 *
 * Helpers for tests that drive a DPDK application rather than the kernel
 * stack.
 * @}
 */

/**
 * @defgroup tapi_netenv Network environment and topology
 * @ingroup te_ts_tapi
 * @{
 *
 * Turning the test bed described in the configuration into the addresses,
 * interfaces and routes a scenario actually uses.
 * @}
 */

/**
 * @defgroup tapi_run Running programs on an agent
 * @ingroup te_ts_tapi
 * @{
 *
 * Starting a process on a Test Agent, feeding it options and reading its
 * output - and the ready-made wrappers for the programs tests reach for
 * most.
 * @}
 */

/**
 * @defgroup tapi_tool_perf Network performance tools
 * @ingroup tapi_run
 * @{
 *
 * Programs that measure throughput, latency or packet rate between two
 * hosts.
 * @}
 */

/**
 * @defgroup tapi_tool_service Server and service tools
 * @ingroup tapi_run
 * @{
 *
 * Daemons a test starts so that it has something to talk to, and the
 * benchmarks that drive them.
 * @}
 */

/**
 * @defgroup tapi_tool_storage Storage and filesystem tools
 * @ingroup tapi_run
 * @{
 *
 * Programs that exercise a block device or build a filesystem on one.
 * @}
 */

/**
 * @defgroup tapi_tool_system System and diagnostic tools
 * @ingroup tapi_run
 * @{
 *
 * Everything else run on an agent: querying a device, loading the machine,
 * or running a third-party test suite.
 * @}
 */

/**
 * @defgroup tapi_sockets Sockets and I/O
 * @ingroup te_ts_tapi
 * @{
 *
 * Working with sockets from the engine side, above the raw RPC calls.
 * @}
 */

/**
 * @defgroup tapi_traffic Traffic generation and capture
 * @ingroup te_ts_tapi
 * @{
 *
 * Building packets, putting them on the wire and matching what comes back.
 * @}
 */

/**
 * @defgroup tapi_tad_main Traffic Application Domain
 * @ingroup tapi_traffic
 * @{
 *
 * Traffic Application Domain (TAD) is a part of Remote Control Facility
 * (RCF) which provides traffic transmission and receiving services on Test
 * Agents. Any kind of data are considered as traffic. For example, IPv4
 * over Ethernet packet, CLI command or its output, SNMP request. Find
 * details in the document: doc/hld/OKTL-HLD-0000236-TE_TAD.sxw
 * @}
 */

/**
 * @defgroup tapi_tad_ipstack IP stack
 * @ingroup tapi_tad_main
 * @{
 *
 * Test API for IP stack CSAP.
 * @}
 */

/**
 * @defgroup tapi_scenario Writing a test scenario
 * @ingroup te_ts_tapi
 * @{
 *
 * The scaffolding every test is built from: parameters, logging, the
 * environment it runs in, and how it reports what it needs and what it
 * did.
 * @}
 */
